{
  "name": "overheat-sdk",
  "version": "0.2.12",
  "description": "TypeScript SDK for the Overheat oracle on Solana and EVM",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-json",
    "copy-json": "node scripts/copy-json.js",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "solana",
    "anchor",
    "sdk",
    "overheat",
    "blockchain",
    "oracle"
  ],
  "author": "OverheatSG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OverheatSG/overheatSDK.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/OverheatSG/overheatSDK/issues"
  },
  "homepage": "https://github.com/OverheatSG/overheatSDK#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0",
    "@irys/sdk": "^0.2.11",
    "@irys/upload": "^0.0.15",
    "@irys/upload-ethereum": "^0.0.16",
    "@solana/web3.js": "^1.87.6",
    "ethers": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
