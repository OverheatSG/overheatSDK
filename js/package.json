{
  "name": "overheat-sdk",
  "version": "0.1.8",
  "description": "Solana SDK for interacting with the Overheat program",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-json",
    "copy-json": "mkdir -p dist/lib && cp lib/*.json dist/lib/ 2>/dev/null || true",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "anchor",
    "sdk",
    "overheat",
    "blockchain",
    "oracle"
  ],
  "author": "OverheatSG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OverheatSG/overheatSDK.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/OverheatSG/overheatSDK/issues"
  },
  "homepage": "https://github.com/OverheatSG/overheatSDK#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0",
    "@irys/sdk": "^0.2.11",
    "@solana/web3.js": "^1.87.6",
    "overheat-sdk": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
